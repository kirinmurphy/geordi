#!/usr/bin/env python3
"""Install or repair the manifest-defined command links.

Works from both the repository checkout and the staged app bundle: the
root is always this script's own checkout/bundle root (parents[2] of
cli/bin/install-cli). Same preflight rules as scripts/install-cli.py
because it is the same Installer — this is just a manifest-registered
entry point so the desktop app and users can enable/repair without
knowing any paths.
"""

from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "cli"))
from geordi_cli.install import main

if __name__ == "__main__":
    sys.exit(main(root=ROOT))
