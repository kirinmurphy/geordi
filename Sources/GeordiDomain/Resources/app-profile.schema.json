{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geordi.local/schemas/app-profile/v1",
  "title": "{{productName}} application profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environment",
    "initialFixtureID",
    "reducedMotion",
    "showDebugEvidence",
    "layout",
    "freshness",
    "destinations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "environment": { "enum": ["synthetic", "liveReadOnly"] },
    "initialFixtureID": { "type": "string", "minLength": 1 },
    "reducedMotion": { "type": "boolean" },
    "showDebugEvidence": { "type": "boolean" },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columnSpacing",
        "rowSpacing",
        "nodeWidth",
        "nodeHeight",
        "minimumScale",
        "maximumScale"
      ],
      "properties": {
        "columnSpacing": { "type": "number", "exclusiveMinimum": 0 },
        "rowSpacing": { "type": "number", "exclusiveMinimum": 0 },
        "nodeWidth": { "type": "number", "exclusiveMinimum": 0 },
        "nodeHeight": { "type": "number", "exclusiveMinimum": 0 },
        "minimumScale": { "type": "number", "exclusiveMinimum": 0 },
        "maximumScale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agingAfterSeconds", "staleAfterSeconds"],
      "properties": {
        "agingAfterSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "staleAfterSeconds": { "type": "integer", "minimum": 1, "maximum": 604800 }
      }
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "breadcrumb", "entityTypes"],
        "properties": {
          "id": {
            "enum": [
              "overview", "storage", "applications", "startup", "commandLine",
              "shellPath", "filesystem", "performance"
            ]
          },
          "breadcrumb": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "entityTypes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "application", "process", "file", "persistence", "resource",
                "incident", "event", "packageManager", "shellFramework", "package"
              ]
            }
          },
          "explorationContextID": { "type": "string", "minLength": 1 },
          "syntheticFocusEntityID": { "type": "string", "minLength": 1 },
          "syntheticNeighborhoodDepth": { "type": "integer", "minimum": 0, "maximum": 4 }
        }
      }
    }
  }
}
