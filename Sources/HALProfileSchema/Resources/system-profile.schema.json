{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/system-profile.schema.json",
  "title": "HAL System Profile",
  "description": "The normalized profile contract shared by synthetic profiles and live system scans.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "summary", "entities", "relationships"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/nonEmptyString" },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "summary": { "$ref": "#/$defs/nonEmptyString" },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "entityType": {
      "type": "string",
      "enum": [
        "application",
        "process",
        "file",
        "persistence",
        "resource",
        "incident",
        "event",
        "packageManager",
        "shellFramework",
        "package"
      ]
    },
    "relationshipType": {
      "type": "string",
      "enum": [
        "owns",
        "launches",
        "reads and writes",
        "persists through",
        "consumes",
        "contributes to",
        "occurred near",
        "may belong to",
        "shares"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["possible", "probable", "high", "confirmed", "ambiguous"]
    },
    "evidenceKind": {
      "type": "string",
      "enum": ["observed", "derived", "inferred"]
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "type": "string" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "name", "summary", "details"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "$ref": "#/$defs/entityType" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "details": {
          "type": "array",
          "items": { "$ref": "#/$defs/detail" }
        }
      }
    },
    "observationID": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawValue"],
      "properties": {
        "rawValue": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "$ref": "#/$defs/evidenceKind" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "observationID": { "$ref": "#/$defs/observationID" },
        "observedAt": { "type": "number" },
        "ruleID": { "$ref": "#/$defs/nonEmptyString" },
        "ruleVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "type",
        "confidence",
        "explanation",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "$ref": "#/$defs/relationshipType" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "explanation": { "$ref": "#/$defs/nonEmptyString" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  }
}
