{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geordi.local/schemas/semantic-stages/v1",
  "title": "{{productName}} semantic graph stages",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "tint", "types"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "tint": { "enum": ["indigo", "blue", "purple", "cyan", "green", "orange"] },
          "types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "application", "process", "file", "persistence", "resource",
                "incident", "event", "packageManager", "shellFramework", "package"
              ]
            }
          }
        }
      }
    }
  }
}
