{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geordi.local/schemas/guided-proof-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "storyEntityID", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1 },
    "storyEntityID": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary", "symbol", "takeaway"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 },
          "takeaway": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
