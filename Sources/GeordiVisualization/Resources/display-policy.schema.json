{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geordi.local/schemas/display-policy-v3.json",
  "title": "{{productName}} display policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contexts"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/context" }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodeBudget", "relationships"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "nodeBudget": { "type": "integer", "minimum": 2 },
        "relationships": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relationshipRule" }
        }
      }
    },
    "relationshipRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "priority", "minimumConfidence"],
      "properties": {
        "type": {
          "enum": [
            "owns", "provides", "launches", "reads and writes", "persists through",
            "consumes", "contributes to", "occurred near", "may belong to", "shares"
          ]
        },
        "priority": { "type": "integer", "minimum": 0 },
        "minimumConfidence": {
          "enum": ["possible", "probable", "high", "confirmed"]
        },
        "groupAfter": { "type": "integer", "minimum": 2 },
        "groupLabel": { "type": "string", "minLength": 1 },
        "groupByDetailLabel": { "type": "string", "minLength": 1 },
        "groupByConfidence": { "type": "boolean" },
        "traversalDepth": { "type": "integer", "minimum": 1, "maximum": 4 }
      },
      "dependentRequired": {
        "groupAfter": ["groupLabel"],
        "groupLabel": ["groupAfter"]
      }
    }
  }
}
