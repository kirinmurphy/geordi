{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geordi.local/schemas/shell-path/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "maximumLines", "startupFiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "maximumLines": { "type": "integer", "minimum": 1, "maximum": 2000 },
    "startupFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "path", "order"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^~/" },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
