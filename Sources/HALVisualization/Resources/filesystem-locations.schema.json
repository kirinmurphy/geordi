{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://hal.local/schemas/filesystem-locations-v2.json",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","locations"],
  "properties":{
    "schemaVersion":{"const":2},
    "locations":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,
      "required":["id","pathTemplate","displayLabel","purpose","system","sensitivity","symbol","enumerationAllowed","maximumDepth","entryBudget"],
      "properties":{
        "id":{"type":"string","minLength":1},"pathTemplate":{"type":"string","pattern":"^/|^\\{home\\}"},
        "displayLabel":{"type":"string","minLength":1},"purpose":{"type":"string","minLength":1},
        "system":{"enum":["platform","applications","shared-services","personal-data","developer-tools"]},
        "sensitivity":{"enum":["public","shared","private","system"]},"symbol":{"type":"string","minLength":1},
        "enumerationAllowed":{"type":"boolean"},"maximumDepth":{"type":"integer","minimum":0,"maximum":4},
        "entryBudget":{"type":"integer","minimum":0,"maximum":10000}
      }
    }}
  }
}
