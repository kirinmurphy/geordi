{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/exploration-contexts-v1.json",
  "title": "HAL exploration contexts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contexts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contexts": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/context" }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "question", "title", "presentation", "supportedEntityTypes",
        "supportedRelationshipTypes", "sections", "drillIn", "initialItemBudget",
        "emptyTitle", "emptyMessage"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "presentation": {
          "enum": ["applicationBrowser", "groupedBrowser", "centeredMap", "purposeBuilt"]
        },
        "supportedEntityTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/entityType" }
        },
        "supportedRelationshipTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relationshipType" }
        },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/$defs/section" }
        },
        "drillIn": { "enum": ["applicationStory", "boundedRelationships", "none"] },
        "initialItemBudget": { "type": "integer", "minimum": 1, "maximum": 100 },
        "emptyTitle": { "type": "string", "minLength": 1 },
        "emptyMessage": { "type": "string", "minLength": 1 },
        "unresolvedTitle": { "type": "string", "minLength": 1 }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "explanation", "entityTypes", "grouping"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "explanation": { "type": "string", "minLength": 1 },
        "entityTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/entityType" }
        },
        "grouping": { "enum": ["flat", "detail", "relationshipOwner"] },
        "detailLabel": { "type": "string", "minLength": 1 },
        "detailValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "relationshipTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relationshipType" }
        },
        "unresolved": { "type": "boolean" }
      },
      "dependentRequired": {
        "detailValues": ["detailLabel"]
      }
    },
    "entityType": {
      "enum": [
        "application", "process", "file", "persistence", "resource", "incident",
        "event", "packageManager", "shellFramework", "package"
      ]
    },
    "relationshipType": {
      "enum": [
        "owns", "provides", "launches", "reads and writes", "persists through",
        "consumes", "contributes to", "occurred near", "may belong to", "shares"
      ]
    }
  }
}
