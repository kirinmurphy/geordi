{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://hal.local/schemas/inspector-display-profile-v1.json",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","fallbackGroupID","groups"],
  "properties":{
    "schemaVersion":{"const":1},"fallbackGroupID":{"type":"string","minLength":1},
    "groups":{"type":"array","minItems":1,"items":{
      "type":"object","additionalProperties":false,"required":["id","label","detailLabels"],
      "properties":{"id":{"type":"string","minLength":1},"label":{"type":"string","minLength":1},
      "detailLabels":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}}
    }}
  }
}
