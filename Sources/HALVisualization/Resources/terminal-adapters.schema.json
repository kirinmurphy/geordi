{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/terminal-adapters-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "adapters"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "bundleIdentifier",
          "requiredURLSchemes",
          "strategy"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "bundleIdentifier": { "type": "string", "minLength": 3 },
          "requiredURLSchemes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "strategy": { "enum": ["workspace-open", "warp-new-window-url"] }
        }
      }
    }
  }
}
