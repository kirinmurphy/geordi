{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/reference-catalog/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "title", "detail", "explanation", "question", "examples",
          "symbol", "tint", "entityTypes"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 },
          "explanation": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "examples": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string", "minLength": 1 },
          "tint": {
            "enum": ["accent", "blue", "cyan", "green", "mint", "orange", "purple", "red"]
          },
          "entityTypes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "application", "process", "file", "persistence", "resource",
                "incident", "event", "packageManager", "shellFramework", "package"
              ]
            }
          }
        }
      }
    }
  }
}
