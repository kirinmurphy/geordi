{
  "schemaVersion": 2,
  "setupEvidence": {
    "path": "/var/db/.AppleSetupDone",
    "toleranceSeconds": 300
  },
  "roots": [
    {
      "id": "system-applications",
      "path": "/Applications",
      "required": true,
      "scope": "system"
    },
    {
      "id": "system-provided-applications",
      "path": "/System/Applications",
      "required": false,
      "scope": "system"
    },
    {
      "id": "user-applications",
      "path": "$USER_HOME/Applications",
      "required": false,
      "scope": "user"
    }
  ]
}
