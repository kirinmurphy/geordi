{
  "schemaVersion": 9,
  "allApplicationsLabel": "All",
  "defaultCategoryID": "user-installed",
  "categories": [
    {
      "id": "system-utilities",
      "kind": "scope",
      "label": "System Utilities",
      "displayOrder": 30,
      "summary": "Utilities and supporting apps included with macOS.",
      "priority": 300,
      "isFallback": false,
      "platformBinaryWhenKnown": true,
      "pathPrefixes": [
        { "path": "/System/Applications/Utilities", "scope": "system" },
        { "path": "/System/Library/CoreServices", "scope": "system" }
      ],
      "detailRules": [],
      "showsInSoftwareSources": false,
      "matchMode": "all"
    },
    {
      "id": "bundled-software",
      "kind": "scope",
      "label": "Bundled Software",
      "filterLabel": "Bundled",
      "displayOrder": 20,
      "summary": "Applications in macOS system locations or observed on this Mac at setup.",
      "priority": 290,
      "isFallback": false,
      "platformBinaryWhenKnown": null,
      "pathPrefixes": [
        { "path": "/System/Applications", "scope": "system" }
      ],
      "detailRules": [
        {
          "label": "App Store receipt",
          "equals": "Present",
          "startsWith": null,
          "excludes": []
        },
        {
          "label": "Installation timing",
          "equals": "Predates setup marker",
          "startsWith": null,
          "excludes": []
        },
        {
          "label": "Bundle identifier",
          "equals": null,
          "startsWith": null,
          "oneOfValues": [
            "com.apple.garageband10",
            "com.apple.iMovieApp",
            "com.apple.Keynote",
            "com.apple.Numbers",
            "com.apple.Pages"
          ],
          "excludes": []
        }
      ],
      "showsInSoftwareSources": false,
      "matchMode": "any"
    },
    {
      "id": "homebrew-cask",
      "kind": "source",
      "label": "Homebrew Casks",
      "summary": "Applications correlated to an installed Homebrew cask through bounded Caskroom receipt evidence.",
      "priority": 400,
      "isFallback": false,
      "platformBinaryWhenKnown": null,
      "pathPrefixes": [],
      "detailRules": [{
        "label": "Installed with",
        "equals": null,
        "startsWith": "Homebrew cask ",
        "excludes": []
      }],
      "showsInSoftwareSources": false,
      "matchMode": "all"
    },
    {
      "id": "app-store",
      "kind": "source",
      "label": "App Store",
      "summary": "Applications with an observed Mac App Store receipt.",
      "priority": 390,
      "isFallback": false,
      "platformBinaryWhenKnown": null,
      "pathPrefixes": [],
      "detailRules": [{
        "label": "App Store receipt",
        "equals": "Present",
        "startsWith": null,
        "excludes": []
      }],
      "showsInSoftwareSources": true,
      "matchMode": "all"
    },
    {
      "id": "downloaded",
      "kind": "source",
      "label": "Downloaded",
      "summary": "Applications with observed filesystem download-origin metadata.",
      "priority": 380,
      "isFallback": false,
      "platformBinaryWhenKnown": null,
      "pathPrefixes": [],
      "detailRules": [{
        "label": "Download origin",
        "equals": null,
        "startsWith": null,
        "excludes": ["Not observed", "Unavailable — metadata could not be read"]
      }],
      "showsInSoftwareSources": false,
      "matchMode": "all"
    },
    {
      "id": "installation-timing-unknown",
      "kind": "scope",
      "label": "Installation Timing Unknown",
      "displayOrder": 40,
      "summary": "Applications for which setup-time filesystem evidence was unavailable.",
      "priority": 200,
      "isFallback": false,
      "platformBinaryWhenKnown": null,
      "pathPrefixes": [],
      "detailRules": [{
        "label": "Installation timing",
        "equals": "Unknown",
        "startsWith": null,
        "excludes": []
      }],
      "showsInSoftwareSources": false,
      "matchMode": "all"
    },
    {
      "id": "user-installed",
      "kind": "scope",
      "label": "User-installed Applications",
      "filterLabel": "User Installed",
      "displayOrder": 10,
      "summary": "Applications added to standard application folders beyond the software included with macOS.",
      "priority": 100,
      "isFallback": false,
      "platformBinaryWhenKnown": false,
      "pathPrefixes": [
        { "path": "/Applications", "scope": "system" },
        { "path": "$USER_HOME/Applications", "scope": "user" }
      ],
      "detailRules": [],
      "showsInSoftwareSources": false,
      "matchMode": "all"
    },
    {
      "id": "other",
      "kind": "scope",
      "label": "Other / Unclassified",
      "displayOrder": 50,
      "summary": "Applications whose location does not match a known software category.",
      "priority": 0,
      "isFallback": true,
      "platformBinaryWhenKnown": null,
      "pathPrefixes": [],
      "detailRules": [],
      "showsInSoftwareSources": false,
      "matchMode": "all"
    }
  ]
}
