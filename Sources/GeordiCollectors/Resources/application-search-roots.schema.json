{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geordi.local/schemas/application-search-roots/v2",
  "title": "{{productName}} application search roots",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "setupEvidence", "roots"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "setupEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "toleranceSeconds"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "toleranceSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 }
      }
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "required", "scope"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "scope": { "enum": ["system", "user"] }
        }
      }
    }
  }
}
