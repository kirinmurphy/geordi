{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geordi.local/schemas/package-ecosystems/v1",
  "title": "{{productName}} package ecosystems",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ecosystems"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ecosystems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "layout", "roots"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "layout": { "enum": ["nodeModules", "pythonUserSitePackages"] },
          "roots": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
