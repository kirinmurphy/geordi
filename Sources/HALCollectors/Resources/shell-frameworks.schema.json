{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/shell-frameworks/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "frameworks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "rootPath",
          "configurationPath",
          "requiredRelativePaths",
          "configurationReferenceTokens",
          "repositoryHosts",
          "repositoryPathSuffixes"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "rootPath": { "type": "string", "pattern": "^\\$USER_HOME/[^.].*|^\\$USER_HOME/\\.[^./].*" },
          "configurationPath": { "type": "string", "pattern": "^\\$USER_HOME/[^.].*|^\\$USER_HOME/\\.[^./].*" },
          "requiredRelativePaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "configurationReferenceTokens": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "repositoryHosts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "repositoryPathSuffixes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
