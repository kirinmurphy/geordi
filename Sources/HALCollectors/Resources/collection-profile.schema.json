{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/collection-profile/v1",
  "title": "HAL collection composition profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "collectors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "collectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "required"],
        "properties": {
          "id": {
            "enum": [
              "applications",
              "applicationSignatures",
              "applicationProvenance",
              "associatedLocations",
              "rebuildableData",
              "processes",
              "persistence",
              "persistenceRuntimeCorrelation",
              "homebrew",
              "runtimes",
              "packageEcosystems",
              "commandLineSoftware",
              "shellFrameworks",
              "applicationClassifications"
            ]
          },
          "enabled": { "type": "boolean" },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
