{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/application-classifications/v9",
  "title": "{{productName}} application classifications",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "allApplicationsLabel",
    "defaultCategoryID",
    "categories"
  ],
  "properties": {
    "schemaVersion": { "const": 9 },
    "allApplicationsLabel": { "type": "string", "minLength": 1 },
    "defaultCategoryID": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "summary",
          "priority",
          "isFallback",
          "platformBinaryWhenKnown",
          "pathPrefixes",
          "detailRules"
          ,"showsInSoftwareSources", "matchMode"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["scope", "source"] },
          "label": { "type": "string", "minLength": 1 },
          "filterLabel": { "type": "string", "minLength": 1 },
          "displayOrder": { "type": "integer", "minimum": 0 },
          "summary": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer", "minimum": 0 },
          "isFallback": { "type": "boolean" },
          "platformBinaryWhenKnown": {
            "type": ["boolean", "null"]
          },
          "pathPrefixes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "scope"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "scope": { "enum": ["system", "user"] }
              }
            }
          },
          "detailRules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "equals", "startsWith", "excludes"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "equals": { "type": ["string", "null"] },
                "startsWith": { "type": ["string", "null"] },
                "oneOfValues": {
                  "type": ["array", "null"],
                  "items": { "type": "string", "minLength": 1 },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "excludes": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "showsInSoftwareSources": { "type": "boolean" }
          ,"matchMode": { "enum": ["all", "any"] }
        }
      }
    }
  }
}
