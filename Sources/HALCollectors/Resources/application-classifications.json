{
  "schemaVersion": 5,
  "allApplicationsLabel": "All Applications",
  "defaultCategoryID": "user-installed",
  "categories": [
    {
      "id": "system-utilities",
      "kind": "scope",
      "label": "System Utilities",
      "summary": "Utilities and supporting apps included with macOS.",
      "priority": 300,
      "isFallback": false,
      "platformBinaryWhenKnown": true,
      "pathPrefixes": [
        { "path": "/System/Applications/Utilities", "scope": "system" },
        { "path": "/System/Library/CoreServices", "scope": "system" }
      ],
      "detailRules": []
    },
    {
      "id": "bundled-software",
      "kind": "scope",
      "label": "Bundled Software",
      "summary": "Applications included in macOS system locations.",
      "priority": 290,
      "isFallback": false,
      "platformBinaryWhenKnown": true,
      "pathPrefixes": [
        { "path": "/System/Applications", "scope": "system" },
        { "path": "/Applications", "scope": "system" }
      ],
      "detailRules": []
    },
    {
      "id": "apple-applications",
      "kind": "scope",
      "label": "Apple Applications",
      "summary": "Apple applications managed through the App Store; current evidence does not establish whether they were preloaded or later installed.",
      "priority": 350,
      "isFallback": false,
      "platformBinaryWhenKnown": null,
      "pathPrefixes": [
        { "path": "/Applications", "scope": "system" }
      ],
      "detailRules": [
        {
          "label": "Bundle identifier",
          "equals": null,
          "startsWith": "com.apple.",
          "excludes": []
        },
        {
          "label": "App Store receipt",
          "equals": "Present",
          "startsWith": null,
          "excludes": []
        }
      ]
    },
    {
      "id": "homebrew-cask",
      "kind": "source",
      "label": "Homebrew Casks",
      "summary": "Applications correlated to an installed Homebrew cask through bounded Caskroom receipt evidence.",
      "priority": 400,
      "isFallback": false,
      "platformBinaryWhenKnown": null,
      "pathPrefixes": [],
      "detailRules": [{
        "label": "Installed with",
        "equals": null,
        "startsWith": "Homebrew cask ",
        "excludes": []
      }]
    },
    {
      "id": "app-store",
      "kind": "source",
      "label": "App Store",
      "summary": "Applications with an observed Mac App Store receipt.",
      "priority": 390,
      "isFallback": false,
      "platformBinaryWhenKnown": null,
      "pathPrefixes": [],
      "detailRules": [{
        "label": "App Store receipt",
        "equals": "Present",
        "startsWith": null,
        "excludes": []
      }]
    },
    {
      "id": "downloaded",
      "kind": "source",
      "label": "Downloaded",
      "summary": "Applications with observed filesystem download-origin metadata.",
      "priority": 380,
      "isFallback": false,
      "platformBinaryWhenKnown": null,
      "pathPrefixes": [],
      "detailRules": [{
        "label": "Download origin",
        "equals": null,
        "startsWith": null,
        "excludes": ["Not observed", "Unavailable — metadata could not be read"]
      }]
    },
    {
      "id": "user-installed",
      "kind": "scope",
      "label": "User-installed Applications",
      "summary": "Applications added to standard application folders beyond the software included with macOS.",
      "priority": 100,
      "isFallback": false,
      "platformBinaryWhenKnown": false,
      "pathPrefixes": [
        { "path": "/Applications", "scope": "system" },
        { "path": "$USER_HOME/Applications", "scope": "user" }
      ],
      "detailRules": []
    },
    {
      "id": "other",
      "kind": "scope",
      "label": "Other / Unclassified",
      "summary": "Applications whose location does not match a known software category.",
      "priority": 0,
      "isFallback": true,
      "platformBinaryWhenKnown": null,
      "pathPrefixes": [],
      "detailRules": []
