{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/rebuildable-data-detectors-v3.json",
  "title": "{{productName}} rebuildable-data detectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "measurementPolicy", "classifications", "detectors"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "measurementPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxEntriesPerLocation",
        "maxDepth",
        "maxDurationMilliseconds",
        "cancellationCheckIntervalEntries",
        "stayOnFileSystem",
        "symbolicLinkPolicy",
        "hardLinkPolicy",
        "clonePolicy"
      ],
      "properties": {
        "maxEntriesPerLocation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "maxDurationMilliseconds": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "cancellationCheckIntervalEntries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "stayOnFileSystem": { "const": true },
        "symbolicLinkPolicy": { "const": "doNotFollow" },
        "hardLinkPolicy": { "const": "countAllocatedBytesOncePerFileID" },
        "clonePolicy": { "const": "allocatedBytesMayOverlap" }
      }
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "rebuildability"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "rebuildability": {
            "enum": ["rebuildable", "redownloadable", "unknown"]
          }
        }
      }
    },
    "detectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "classificationID",
          "locations",
          "excludedDescendantNames",
          "manager",
          "evidenceRule"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "classificationID": { "type": "string", "minLength": 1 },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "path"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "pattern": "^\\$USER_HOME/" }
              }
            }
          },
          "excludedDescendantNames": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "manager": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          },
          "evidenceRule": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "confidence", "explanation"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["toolManagedRoot", "pathConvention"] },
              "confidence": {
                "enum": ["possible", "probable", "high", "confirmed"]
              },
              "explanation": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
