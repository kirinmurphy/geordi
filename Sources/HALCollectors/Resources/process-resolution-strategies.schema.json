{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/process-resolution-strategies/v3",
  "title": "HAL process resolution strategies",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "maxProcessesPerApplication",
    "maxUnmatchedProcesses",
    "strategies"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "maxProcessesPerApplication": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "maxUnmatchedProcesses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "confidence", "priority"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["exactMainExecutable", "containedInApplicationBundle", "relocatedBundleName"]
          },
          "confidence": {
            "enum": ["possible", "probable", "high", "confirmed", "ambiguous"]
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
