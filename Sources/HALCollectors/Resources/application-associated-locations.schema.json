{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/application-associated-locations/v2",
  "title": "HAL application associated locations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locations", "enumerationRoots"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "categoryLabel", "pathTemplate", "match"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "categoryLabel": {
            "type": "string",
            "minLength": 1
          },
          "pathTemplate": {
            "type": "string",
            "pattern": "^\\$USER_HOME/"
          },
          "match": {
            "enum": ["bundleIdentifier", "applicationName"]
          }
        }
      }
    },
    "enumerationRoots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "categoryLabel", "path", "matching", "maxEntries"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "categoryLabel": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^\\$USER_HOME/"
          },
          "matching": {
            "enum": ["applicationIdentifiers", "groupIdentifierUnavailable"]
          },
          "maxEntries": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        }
      }
    }
  }
}
