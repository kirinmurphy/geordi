{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/application-associated-locations/v1",
  "title": "HAL application associated locations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locations"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "categoryLabel", "pathTemplate", "match"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "categoryLabel": {
            "type": "string",
            "minLength": 1
          },
          "pathTemplate": {
            "type": "string",
            "pattern": "^\\$USER_HOME/"
          },
          "match": {
            "enum": ["bundleIdentifier", "applicationName"]
          }
        }
      }
    }
  }
}
