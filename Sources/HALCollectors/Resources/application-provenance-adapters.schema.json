{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/application-provenance-adapters/v2",
  "title": "HAL application provenance adapters",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "adapters"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "displayLabel"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["appStoreReceipt", "downloadOrigin", "homebrewCask"]
          },
          "displayLabel": {
            "type": "string",
            "minLength": 1
          },
          "pathPrefixes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
