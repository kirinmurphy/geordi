{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/application-provenance-adapters/v3",
  "title": "{{productName}} application provenance adapters",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "adapters"],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "displayLabel"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["appStoreReceipt", "downloadOrigin"]
          },
          "displayLabel": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
