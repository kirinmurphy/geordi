{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/command-line-software/v1",
  "title": "HAL command-line software roots",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "roots"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "path", "scope", "maxEntries"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["system", "user"] },
          "maxEntries": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "packageManagerID": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
