{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/application-search-roots/v1",
  "title": "HAL application search roots",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "roots"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "required", "scope"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "scope": { "enum": ["system", "user"] }
        }
      }
    }
  }
}
