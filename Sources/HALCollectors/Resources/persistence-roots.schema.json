{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/persistence-roots/v1",
  "title": "{{productName}} persistence roots",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "roots"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "kind", "scope"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["launchAgent", "launchDaemon"]
          },
          "scope": {
            "enum": ["system", "user"]
          }
        }
      }
    }
  }
}
