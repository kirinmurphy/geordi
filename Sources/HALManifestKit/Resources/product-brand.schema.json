{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hal.local/schemas/product-brand/v1",
  "title": "Product brand",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "displayName", "dataDirectoryName"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 64 },
    "dataDirectoryName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^/:]+$"
    }
  }
}
