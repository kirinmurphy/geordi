{
  "schemaVersion": 1,
  "items": [
    {
      "id": "git",
      "label": "Git",
      "group": "cli",
      "detect": [
        {
          "type": "command",
          "value": "git"
        }
      ],
      "install": {
        "type": "manual",
        "instructions": "Install Apple Command Line Tools with xcode-select --install, complete the dialog, then rerun."
      }
    },
    {
      "id": "brew",
      "label": "Homebrew",
      "group": "cli",
      "detect": [
        {
          "type": "command",
          "value": "brew"
        }
      ],
      "install": {
        "type": "manual",
        "instructions": "Install Homebrew following https://brew.sh, add its bin directory to PATH, then rerun. Homebrew installation is not automated."
      }
    },
    {
      "id": "hermes",
      "label": "Hermes",
      "group": "cli",
      "detect": [
        {
          "type": "command",
          "value": "hermes"
        }
      ],
      "install": {
        "type": "manual",
        "instructions": "Install Hermes using the official instructions at https://hermes-agent.nousresearch.com/docs ; command detection records its resolved path, not a guessed Homebrew package."
      }
    },
    {
      "id": "cmux",
      "label": "cmux",
      "group": "apps",
      "detect": [
        {
          "type": "app",
          "value": "/Applications/cmux.app"
        }
      ],
      "install": {
        "type": "brewCask",
        "package": "cmux"
      },
      "dependsOn": [
        "brew"
      ]
    },
