        "package": "@anthropic-ai/claude-code"
      }
    },
    {
      "id": "oh-my-zsh",
      "label": "Oh My Zsh",
      "group": "shell",
      "enabled": false,
      "detect": [
        {
          "type": "path",
          "value": "$HOME/.oh-my-zsh"
        }
      ],
      "install": {
        "type": "manual",
        "instructions": "Review and follow https://ohmyz.sh ; shell configuration is not changed by bootstrap."
      }
    }
  ],
